{
  "name": "persona-dialogue-generator",
  "version": "2.0.0",
  "description": "Persona 4 / 5 dialogue box generator — static build for GitHub Pages",
  "homepage": "https://fastdemo.github.io/persona/",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-catalog.mjs && vite build",
    "preview": "vite preview",
    "precatalog": "node scripts/generate-catalog.mjs",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "keywords": [
    "Persona 5",
    "Persona 4",
    "generator",
    "dialogue"
  ],
  "author": "opennoise",
  "license": "ISC",
  "dependencies": {
    "fontfaceobserver": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
